func generateRandomCharacter()->CharacterResource:
	var character:CharacterResource = CharacterResource.new()
	character.displayName = nameArray.pick_random()
	character.battleClass = classArray.pick_random()
	if character.battleClass.potentialPassives.is_empty() != false:
		character.passiveAbility = character.battleClass.potentialPassives.pick_random()
	character.moveList.append(preload("res://Resources/Moves/BasicAttack.tres"))
	if character.battleClass.movesPerLevelDict.has(0):
		character.moveList.append(character.battleClass.movesPerLevelDict.get(0))
	if character.battleClass.movesPerLevelDict.has(1):
		character.moveList.append(character.battleClass.movesPerLevelDict.get(1))
	
	character.characterModel = charModelArray.pick_random()
	
	character.defense = 10 + rng.randi_range(-5,7) + int(character.battleClass.defenseGrowth)
	character.maxHealth = 10 + rng.randi_range(-5,7) + int(character.battleClass.healthGrowth)
	character.willpower = 10 + rng.randi_range(-5,7) + int(character.battleClass.willpowerGrowth)
	character.strength = 10 + rng.randi_range(-5,7) + int(character.battleClass.strengthGrowth)
	character.maxMana = 10 + rng.randi_range(-5,7) + int(character.battleClass.manaGrowth)
	character.intelligence = 10 + rng.randi_range(-5,7) + int(character.battleClass.intelligenceGrowth)
	character.speed = 10 + rng.randi_range(-5,7) + int(character.battleClass.speedGrowth)
	character.luck = 10 + rng.randi_range(-5,7) + int(character.battleClass.luckGrowth)
	
	character.currentHealth = character.maxHealth
	character.currentMana = character.maxMana
	
	return character
